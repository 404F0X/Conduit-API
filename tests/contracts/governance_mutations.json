  "atomic_publish": true,
  "review_only": [
    "APPROVE",
    "approveChangeSet"
  ],
  "combined_action": {
    "name": "APPROVE_APPLY",
    "required_duties": [
      "review_changes",
      "publish_changes"
    ],
    "same_transaction": true
  },
  "exceptions": [
    "reads/observations",
    "self-profile and restricted self-key",
    "signup fixed personal workspace",
    "issued redemption and issued entitlement lifecycle",
    "ordinary accounting/reserve/settle/reconcile",
    "monotonic emergency or health restriction",
    "onboarding flags and presentation only",
    "backup/restore/cache/GC maintenance with existing strong permissions"
  ],
  "composite_policies": [
    "channel import/create/duplicate with supply",
    "channel settings with aliases",
    "group price and group PriceTier linkage",
    "group membership with Project configuration",
    "Project creation with fixed membership/roles"
  ],
