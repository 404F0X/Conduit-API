    },
    {
      "field": "reviewChangeSet",
      "classification": "exception",
      "guard": "state machine rechecks domain, Project, duties and separation; ApproveApply explicitly requires review_changes + publish_changes and performs both steps in one transaction"
    },
    {
      "field": "publishChangeSet",
      "classification": "exception",
      "guard": "formal atomic transaction only; Approved or explicit approval-OFF draft, publish duty, policy/version/target/module rechecks; no per-target commits"
    },
    {
      "field": "recoverGovernancePolicy",
