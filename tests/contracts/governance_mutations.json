      "field": "setProjectMemberSpendLimit",
      "classification": "ProjectConfiguration"
    },
    {
      "field": "claimGovernedChangeSecrets",
      "classification": "exception",
      "guard": "one-time private receipt; actual recipient, current domain authority and applied package rechecked; public items/events omit secrets"
    },
    {
      "field": "updateGovernanceSettings",
