          "format": "int32",
          "type": "integer"
        },
        "stdout": {
          "default": true,
          "description": "Rust-only. Mirror of Go `output == \"stdio\"`. Default: true.",
          "type": "boolean"
        },
        "time_key": {
          "default": "time",
          "description": "Go `log.Config.TimeKey` (`time_key`). Go default: \"time\".",
          "type": "string"
