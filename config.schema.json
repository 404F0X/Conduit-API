    "DatabaseConfig": {
      "additionalProperties": false,
      "properties": {
        "conn_max_idle_time": {
          "default": "10m",
          "description": "Maps to Go `db.conn_max_idle_time` (`SetConnMaxIdleTime`). Go default \"10m\".",
          "type": "string"
        },
        "conn_max_lifetime": {
