          "description": "Maps to Go `db.conn_max_lifetime` (`SetConnMaxLifetime`). Go default \"30m\".",
          "type": "string"
        },
        "connect_timeout": {
          "default": "30s",
          "description": "Acquire timeout for a connection from the pool (sqlx-side; no direct Go `db.Config` equivalent). Kept for runtime use. Default 30s.",
          "type": "string"
        },
        "debug": {
          "default": false,
          "type": "boolean"
        },
        "dialect": {
          "default": "postgres",
          "type": "string"
        },
        "disable_auto_migration": {
          "default": false,
          "type": "boolean"
        },
        "dsn": {
          "default": "postgresql://conduit:conduit@127.0.0.1:5432/conduit",
          "type": "string"
        },
        "max_idle_conns": {
          "default": 10,
          "description": "Maps to Go `db.max_idle_conns` (`SetMaxIdleConns`). Go default 10.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_open_conns": {
          "default": 20,
          "description": "Maps to Go `db.max_open_conns` (`SetMaxOpenConns`). Go default 20.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "read_replica": {
          "allOf": [
            {
              "$ref": "#/definitions/DbReadReplicaConfig"
            }
          ],
          "default": {
            "fallback_on_replica_failure": false,
            "read_dsn": "",
            "read_max_idle_conns": 0,
            "read_max_open_conns": 0
          }
        }
      },
      "type": "object"
    },
    "DbReadReplicaConfig": {
      "additionalProperties": false,
      "description": "Mirrors Go `db.ReadReplicaConfig` (`conduit/internal/server/db/config.go`) plus the Rust-only `fallback_on_replica_failure` switch (RUST-P3-001 S11). Defaults: empty DSN, 0 conns (=> use pool defaults / disabled), `fallback_on_replica_failure = false`.\n\nGo semantics (verified against `conduit/internal/server/db/router.go`): when a replica is configured, the Ent read path calls `replica.Query` *directly* with **no try/catch and no runtime fallback** — a replica failure propagates to the caller. To stay byte-compatible with that behavior the Rust default is therefore `false` (do not fall back to master when the replica fails at runtime). Writes (`Exec`) and transactions always run on master regardless of this flag, so replica outages never break the write path — this is what \"default compatible with Go\" guarantees.",
      "properties": {
        "fallback_on_replica_failure": {
          "default": false,
          "description": "When `true`, a runtime failure on the replica (connection error, pool exhaustion, etc.) falls back to executing the read on master. When `false` (default, Go-compatible) the error is propagated as-is. Has no effect when no replica is configured (reads always use master) and never affects writes or transactions.",
          "type": "boolean"
        },
        "read_dsn": {
          "default": "",
          "type": "string"
        },
        "read_max_idle_conns": {
          "default": 0,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "read_max_open_conns": {
          "default": 0,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "GcConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "requests_cleanup_enabled": {
          "default": false,
          "type": "boolean"
        },
        "requests_retention": {
          "default": "3d",
          "type": "string"
        },
        "stale_processing_enabled": {
          "default": true,
          "type": "boolean"
        },
        "stale_processing_interval": {
          "default": "1m",
          "type": "string"
        },
        "usage_logs_cleanup_enabled": {
          "default": false,
          "type": "boolean"
        },
        "usage_logs_retention": {
          "default": "30d",
          "type": "string"
        },
        "vacuum_enabled": {
          "default": false,
          "description": "Whether the policy-driven GC runs `VACUUM` after cleanup (Go `gc.Config.VacuumEnabled`, `gc.go:198`). P-47.",
          "type": "boolean"
        },
        "vacuum_full": {
          "default": false,
          "description": "Whether PostgreSQL VACUUM uses the locking `FULL` variant (Go `gc.Config.VacuumFull`). P-47.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
